[Unit]
Description=Prometheus-cadvisor service
Requires=docker.service
After=docker.service

[Service]
Type=simple
Environment="HOME={{ systemd_unit_home_path }}"
ExecStartPre=-{{ host_command_sh }} -c '{{ host_command_docker }} kill prometheus-cadvisor 2>/dev/null'
ExecStartPre=-{{ host_command_sh }} -c '{{ host_command_docker }} rm prometheus-cadvisor 2>/dev/null'

## cAdvisor's official Docker invocation requires privileged access and /dev/kmsg
## to gather complete container metrics. It is not published to the host network.
ExecStart=/usr/bin/docker run --rm --name prometheus-cadvisor \
	--log-driver=none \
	--network={{ nginx_docker_network }} \
	--env TZ={{ timezone }} \
	--privileged \
	-v /:/rootfs:ro \
	-v /var/run:/var/run:ro \
	-v /sys:/sys:ro \
	-v /var/lib/docker/:/var/lib/docker:ro \
	-v /dev/disk/:/dev/disk:ro \
	--device=/dev/kmsg \
	{{ prometheus_cadvisor_exporter_docker_image }}


ExecStop=-{{ host_command_sh }} -c '{{ host_command_docker }} stop --timeout={{ prometheus_shutdown_timeout }} prometheus-cadvisor 2>/dev/null'
ExecStopPost=-{{ host_command_sh }} -c '{{ host_command_docker }} rm prometheus-cadvisor 2>/dev/null'
TimeoutStopSec={{ prometheus_shutdown_timeout | int + 30 }}
Restart=always
RestartSec=30
SyslogIdentifier=prometheus-cadvisor

[Install]
WantedBy=multi-user.target
