# The official GitLab image reads its Linux-package configuration from this
# variable. It must be passed on every `docker run`, so it intentionally stays
# in this root-only environment file rather than relying on a generated state
# inside the container.
GITLAB_OMNIBUS_CONFIG=external_url {{ ('http://' ~ gitlab_service_hostname) | to_json }}; nginx['listen_port'] = 80; nginx['listen_https'] = false; gitlab_rails['gitlab_shell_ssh_port'] = {{ gitlab_ssh_host_port }}; puma['worker_processes'] = {{ gitlab_puma_workers | int }}; sidekiq['max_concurrency'] = {{ gitlab_sidekiq_concurrency | int }}; prometheus_monitoring['enable'] = {{ gitlab_builtin_monitoring_enabled | bool | lower }}; prometheus['enable'] = {{ gitlab_builtin_monitoring_enabled | bool | lower }}; sidekiq['metrics_enabled'] = {{ gitlab_builtin_monitoring_enabled | bool | lower }}; puma['exporter_enabled'] = {{ gitlab_builtin_monitoring_enabled | bool | lower }};{% if gitlab_root_password | default('') | length > 0 %} gitlab_rails['initial_root_password'] = {{ gitlab_root_password | to_json }};{% endif %}{% if gitlab_smtp_enabled | bool %} gitlab_rails['smtp_enable'] = true; gitlab_rails['smtp_address'] = {{ gitlab_smtp_host | to_json }}; gitlab_rails['smtp_port'] = {{ gitlab_smtp_port | int }}; gitlab_rails['smtp_domain'] = {{ gitlab_smtp_domain | to_json }}; gitlab_rails['smtp_user_name'] = {{ gitlab_smtp_user | to_json }}; gitlab_rails['smtp_password'] = {{ gitlab_smtp_pass | to_json }}; gitlab_rails['smtp_authentication'] = {{ gitlab_smtp_authentication | to_json }}; gitlab_rails['smtp_tls'] = {{ gitlab_smtp_tls | bool | lower }};{% endif %}

GITLAB_DEFAULT_THEME={{ gitlab_default_theme }}

GITLAB_USERNAME_CHANGE=false

PUMA_WORKERS={{ gitlab_puma_workers }}
SIDEKIQ_CONCURRENCY={{ gitlab_sidekiq_concurrency }}

GITLAB_PROJECTS_WIKI={{ gitlab_projects_wiki|to_json }}
GITLAB_PROJECTS_SNIPPETS={{ gitlab_projects_snippets|to_json }}
GITLAB_PROJECTS_BUILDS={{ gitlab_projects_builds|to_json }}
GITLAB_PROJECTS_ISSUES={{ gitlab_projects_issues|to_json }}

GITLAB_EMAIL={{ gitlab_email }}
GITLAB_EMAIL_REPLY_TO={{ gitlab_email_reply_to }}

SMTP_ENABLED={{ gitlab_smtp_enabled|to_json }}
SMTP_DOMAIN={{ gitlab_smtp_domain }}
SMTP_HOST={{ gitlab_smtp_host }}
SMTP_PORT={{ gitlab_smtp_port }}
SMTP_USER={{ gitlab_smtp_user }}
SMTP_PASS={{ gitlab_smtp_pass }}
SMTP_TLS={{ gitlab_smtp_tls|to_json }}
SMTP_AUTHENTICATION={{ gitlab_smtp_authentication }}

time_zone=Europe/Samara

GITLAB_MONITORING_SIDEKIQ_EXPORTER_ENABLED=false
