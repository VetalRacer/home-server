[Unit]
Description=SearXNG Valkey service
Requires=docker.service
After=docker.service

[Service]
Type=simple
Environment="HOME={{ systemd_unit_home_path }}"
ExecStartPre=-{{ host_command_sh }} -c '{{ host_command_docker }} kill searxng_valkey 2>/dev/null'
ExecStartPre=-{{ host_command_sh }} -c '{{ host_command_docker }} rm searxng_valkey 2>/dev/null'

ExecStart=/usr/bin/docker run --rm --name searxng_valkey \
	--log-driver=none \
    --network={{ nginx_docker_network }} \
    --cap-drop=ALL \
    --cap-add=CHOWN \
    --cap-add=DAC_OVERRIDE \
	--cap-add=SETGID \
	--cap-add=SETUID \
	--security-opt=no-new-privileges:true \
	--tmpfs /data:rw,noexec,nosuid,size=64m \
	{{ searxng_valkey_docker_image }} \
	valkey-server --save 30 1 --loglevel warning

ExecStop=-{{ host_command_sh }} -c '{{ host_command_docker }} stop --timeout=60 searxng_valkey 2>/dev/null'
ExecStop=-{{ host_command_sh }} -c '{{ host_command_docker }} rm searxng_valkey 2>/dev/null'
Restart=always
RestartSec=30
SyslogIdentifier=searxng-valkey

[Install]
WantedBy=multi-user.target
