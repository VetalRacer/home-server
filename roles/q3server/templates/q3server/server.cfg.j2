// Managed by Ansible. Do not edit this file on the server.
// =============================================
// Конфигурационный файл сервера Quake 3 Arena
// =============================================

// === АДМИНИСТРАТИВНАЯ ИНФОРМАЦИЯ ===
sets ".Admin" "{{ q3server_admin_name }}" // Имя администратора сервера
sets ".email" "{{ q3server_admin_email }}" // Контактный email администратора
sets ".www" "{{ q3server_website }}" // Связанный веб-сайт

// === ОСНОВНЫЕ НАСТРОЙКИ СЕРВЕРА ===
seta sv_hostname "{{ q3server_server_name }}" // Отображаемое имя сервера
seta g_motd "{{ q3server_motd }}" // Приветственное сообщение для игроков

// === НАСТРОЙКИ ИГРОКОВ И СЛОТОВ ===
seta sv_maxClients 16 // Максимальное число игроков, включая ботов
seta sv_privateClients 6 // Число зарезервированных слотов
seta sv_privatePassword "{{ q3server_private_password }}" // Пароль приватных слотов
seta g_synchronousClients 0 // Стандартная синхронизация клиентов
seta g_allowvote 1 // Разрешить голосования

// === ПАРАМЕТРЫ ИГРОВОГО ПРОЦЕССА ===
seta g_gametype 0 // 0: FFA, 1: Tournament, 3: Team Deathmatch, 4: CTF
seta timelimit 10 // Лимит времени матча в минутах
seta fraglimit 25 // Лимит фрагов для победы
seta g_inactivity 3000 // Таймаут неактивности в секундах
seta g_quadfactor 3 // Множитель урона Quad Damage
seta g_weaponrespawn 15 // Время возрождения оружия в секундах
seta g_friendlyfire 0 // Урон по союзникам выключен
seta g_teamAutoJoin 0 // Не распределять игроков по командам автоматически
seta g_forcerespawn 2 // Принудительное возрождение

// === ФИЗИКА И ПРОИЗВОДИТЕЛЬНОСТЬ ===
seta pmove_fixed 1 // Фиксированный шаг физики
seta sv_fps 30 // Частота обновления сервера

// === НАСТРОЙКИ БОТОВ ===
seta bot_enable 1 // Включить ботов
seta bot_minplayers 8 // Поддерживать не менее восьми игроков с ботами
seta g_spskill 5 // Уровень сложности ботов: 1–5
seta bot_nochat 0 // Не отключать чат ботов

// === ВНЕШНИЕ MASTER-СЕРВЕРЫ ===
// Список пуст по умолчанию: игроки подключаются напрямую по IP/имени и порту.
{% for master_server in q3server_master_servers %}
seta sv_master{{ loop.index }} "{{ master_server }}"
{% endfor %}

// === УДАЛЁННОЕ АДМИНИСТРИРОВАНИЕ ===
seta rconpassword "{{ q3server_rcon_password }}" // Пароль RCON

// === ЦИКЛ КАРТ ===
set d1 "map q3dm1 ; set nextmap vstr d2"
set d2 "map q3dm2 ; set nextmap vstr d3"
set d3 "map q3dm3 ; set nextmap vstr d4"
set d4 "map q3dm4 ; set nextmap vstr d5"
set d5 "map q3dm5 ; set nextmap vstr d6"
set d6 "map q3dm6 ; set nextmap vstr d7"
set d7 "map q3dm7 ; set nextmap vstr d8"
set d8 "map q3dm8 ; set nextmap vstr d9"
set d9 "map q3dm9 ; set nextmap vstr d10"
set d10 "map q3dm10 ; set nextmap vstr d11"
set d11 "map q3dm11 ; set nextmap vstr d12"
set d12 "map q3dm12 ; set nextmap vstr d13"
set d13 "map q3dm13 ; set nextmap vstr d14"
set d14 "map q3dm14 ; set nextmap vstr d15"
set d15 "map q3dm15 ; set nextmap vstr d16"
set d16 "map q3dm16 ; set nextmap vstr d17"
set d17 "map q3dm17 ; set nextmap vstr d18"
set d18 "map q3dm18 ; set nextmap vstr d19"
set d19 "map q3dm19 ; set nextmap vstr d1"
vstr d1
