[Unit]
Description=Samba service
Requires=docker.service
After=docker.service
DefaultDependencies=no

[Service]
Type=simple
Environment="HOME={{ systemd_unit_home_path }}"
ExecStartPre=-{{ host_command_sh }} -c '{{ host_command_docker }} kill samba 2>/dev/null'
ExecStartPre=-{{ host_command_sh }} -c '{{ host_command_docker }} rm samba 2>/dev/null'

ExecStart=/usr/bin/docker run --rm --name samba \
			--log-driver=none \
			--tmpfs /tmp:rw,noexec,nosuid,nodev,size=16m \
			--tmpfs /run:rw,exec,nosuid,nodev,size=16m \
			--cap-drop=ALL \
			--cap-add=CHOWN \
			--cap-add=DAC_OVERRIDE \
			--cap-add=FOWNER \
			--cap-add=SETGID \
			--cap-add=SETUID \
			--cap-add=NET_BIND_SERVICE \
			--security-opt=no-new-privileges:true \
			--env TZ={{ timezone }} \
			--env SAMBA_LOG_LEVEL={{ samba_log_level }} \
			--env SAMBA_HOSTS_ALLOW="{{ samba_allowed_hosts | join(' ') }}" \
			--env-file {{ samba_base_data_path }}/samba.env \
{% for samba_share in samba_shares %}
			-v {{ samba_share.host_path }}:{{ samba_share.container_path }} \
{% endfor %}
			-p {{ samba_listen_address }}:445:445/tcp \
			-v {{ samba_data_path }}:/data \
			-v {{ samba_data_path }}/config.yml:/data/config.yml:ro \
			{{ samba_docker_image }}

ExecStop=-{{ host_command_sh }} -c '{{ host_command_docker }} kill samba 2>/dev/null'
ExecStop=-{{ host_command_sh }} -c '{{ host_command_docker }} rm samba 2>/dev/null'
Restart=always
RestartSec=30
SyslogIdentifier=samba

[Install]
WantedBy=multi-user.target
