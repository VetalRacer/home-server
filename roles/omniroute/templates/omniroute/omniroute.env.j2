# Managed by Ansible. Values are sourced from Ansible Vault.
APP_BIND_HOST=0.0.0.0
DASHBOARD_PORT={{ omniroute_service_port }}
REQUIRE_API_KEY=true
OMNIROUTE_MEMORY_MB={{ omniroute_memory_mb }}
OMNIROUTE_WS_BRIDGE_SECRET={{ omniroute_ws_bridge_secret }}
APP_LOG_RETENTION_DAYS={{ omniroute_app_log_retention_days }}
APP_LOG_MAX_FILES={{ omniroute_app_log_max_files }}
CALL_LOG_RETENTION_DAYS={{ omniroute_call_log_retention_days }}
CALL_LOGS_TABLE_MAX_ROWS={{ omniroute_call_logs_table_max_rows }}
ENABLE_REQUEST_LOGS={{ omniroute_enable_request_logs | ternary('true', 'false') }}
JWT_SECRET={{ omniroute_jwt_secret }}
API_KEY_SECRET={{ omniroute_api_key_secret }}
STORAGE_ENCRYPTION_KEY={{ omniroute_storage_encryption_key }}
REDIS_URL=redis://:{{ omniroute_redis_password }}@{{ omniroute_redis_host }}:{{ omniroute_redis_port }}/0
REDIS_PASSWORD={{ omniroute_redis_password }}
