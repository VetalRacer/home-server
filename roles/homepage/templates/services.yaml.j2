- {{ text('Tools', 'Инструменты') }}:
{% if transmission_installation_enabled == true %}
    - Transmission:
        icon: transmission.png
        href: http://{{ transmission_service_hostname }}
        description: {{ text('Torrent downloader', 'Загрузчик торрентов') }}
{% if homepage_docker_integration_enabled | bool %}
        server: homeserver
        container: transmission
{% endif %}
        widget:
          type: transmission
          url: http://transmission:9091
          username: {{ transmission_username }}
          password: {{ transmission_password }}
{% endif %}
{% if planka_installation_enabled == true %}
    - Planka:
        icon: https://cdn.jsdelivr.net/gh/selfhst/icons/png/planka.png
