BASE_URL={{ planka_base_url | to_json }}
DATABASE_URL=postgresql://{{ planka_postgres_user | string | urlencode | replace('/', '%2F') }}:{{ planka_postgres_password | string | urlencode | replace('/', '%2F') }}@{{ planka_postgres_host }}/{{ planka_postgres_db | string | urlencode | replace('/', '%2F') }}
SECRET_KEY={{ planka_secret_key | to_json }}
TRUST_PROXY={{ planka_trust_proxy | ternary('true', 'false') }}
DEFAULT_ADMIN_EMAIL={{ planka_default_admin_email | to_json }}
DEFAULT_ADMIN_USERNAME={{ planka_default_admin_username | to_json }}
DEFAULT_ADMIN_PASSWORD={{ planka_default_admin_password | to_json }}
DEFAULT_ADMIN_NAME={{ planka_default_admin_name | to_json }}
