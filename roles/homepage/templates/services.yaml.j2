{% if homepage_docker_integration_enabled | bool %}
        server: homeserver
        container: speedtest
{% endif %}
{% if speedtest_homepage_api_key | default('') | length > 0 %}
        widget:
          type: speedtest
          url: http://speedtest:80
          version: 2
          key: {{ speedtest_homepage_api_key }}
{% endif %}
{% endif %}
