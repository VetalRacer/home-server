{% endif %}
{% endif %}
{% if pihole_installation_enabled == true %}
    - PiHole:
        icon: pi-hole.png
        href: http://{{ pihole_service_hostname }}/admin
        description: {{ text('Network-wide protection', 'Защита всей сети') }}
{% if homepage_docker_integration_enabled | bool %}
        server: homeserver
        container: pihole
{% endif %}
        widget:
          type: pihole
          url: http://pihole:3080
          version: 6
          key: {{ pihole_service_webpassword }}
{% endif %}
{% if speedtest_installation_enabled == true %}
    - Speedtest:
        icon: https://cdn.jsdelivr.net/gh/selfhst/icons/png/speedtest.png
