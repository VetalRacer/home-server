---
# For configuration options and examples, please see:
# https://gethomepage.dev/en/configs/services
{% macro text(english, russian) -%}
{{ (russian if homepage_language == 'ru' else english) | to_json }}
{%- endmacro %}

- {{ text('Media', 'Медиа') }}:
{% if plex_installation_enabled == true %}
    - Plex:
        icon: plex.png
        href: http://{{ plex_service_hostname }}
        description: {{ text('Media server', 'Медиасервер') }}
{% if homepage_docker_integration_enabled | bool %}
        server: homeserver
        container: plex
{% endif %}
        widget:
          type: plex
          url: http://plex:32400
          key: {{ plex_apikey }}
{% endif %}
{% if tubearchivist_installation_enabled == true %}
    - TubeArchivist:
        icon: https://cdn.jsdelivr.net/gh/selfhst/icons/png/tube-archivist.png
        href: http://{{ tubearchivist_service_hostname }}
        description: {{ text('YouTube media archive', 'Архив медиа с YouTube') }}
{% if homepage_docker_integration_enabled | bool %}
        server: homeserver
        container: tubearchivist
{% endif %}
{% endif %}
