[Unit]
Description=Prometheus-blackbox service
Requires=docker.service
After=docker.service

[Service]
Type=simple
Environment="HOME={{ systemd_unit_home_path }}"
ExecStartPre=-{{ host_command_sh }} -c '{{ host_command_docker }} kill prometheus-blackbox 2>/dev/null'
ExecStartPre=-{{ host_command_sh }} -c '{{ host_command_docker }} rm prometheus-blackbox 2>/dev/null'

ExecStart=/usr/bin/docker run --rm --name prometheus-blackbox \
	--log-driver=none \
	--network={{ nginx_docker_network }} \
	--env TZ={{ timezone }} \
	--read-only \
	--tmpfs /tmp:rw,noexec,nosuid,size=16m \
	--cap-drop=ALL \
	--cap-add=NET_RAW \
	--security-opt=no-new-privileges:true \
	-v {{ prometheus_blackbox_exporter_config_path }}:/config:ro \
	{{ prometheus_blackbox_exporter_docker_image }} \
	--config.file=/config/blackbox.yml


ExecStop=-{{ host_command_sh }} -c '{{ host_command_docker }} stop --timeout={{ prometheus_shutdown_timeout }} prometheus-blackbox 2>/dev/null'
ExecStopPost=-{{ host_command_sh }} -c '{{ host_command_docker }} rm prometheus-blackbox 2>/dev/null'
TimeoutStopSec={{ prometheus_shutdown_timeout | int + 30 }}
Restart=always
RestartSec=30
SyslogIdentifier=prometheus-blackbox

[Install]
WantedBy=multi-user.target
