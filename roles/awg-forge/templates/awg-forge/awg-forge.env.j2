# Managed by Ansible. Values marked as secrets are supplied through Vault.
WEBUI_HOST={{ awgforge_webui_host }}
WEBUI_PORT={{ awgforge_webui_port }}
PASSWORD={{ awgforge_password }}
SESSION_SECRET={{ awgforge_session_secret }}
SESSION_COOKIE_SECURE={{ awgforge_session_cookie_secure | ternary('true', 'false') }}
WEBUI_TRUST_PROXY_HEADERS=false
WEBUI_TRUSTED_PROXY_CIDRS=
DNS={{ awgforge_client_dns }}
EXTERNAL_INTERFACE={{ awgforge_external_interface }}
APPLY_CONFIG={{ awgforge_apply_config | ternary('true', 'false') }}
PUBLISHED_UDP_PORTS=
TUNNEL_UDP_PORT_RANGE={{ awgforge_tunnel_udp_port_range }}
AUDIT_LOG_ENABLED={{ awgforge_audit_log_enabled | ternary('true', 'false') }}
AUDIT_LOG_PATH=/etc/awg-forge/audit.log
AUDIT_LOG_MAX_SIZE=5242880
AUDIT_LOG_MAX_FILES=3
LOG_LEVEL=info
DATABASE_MODE=sqlite
DATABASE_PATH=/etc/awg-forge/awg-forge.db
DATABASE_DSN=
DATABASE_RETENTION_DAYS={{ awgforge_database_retention_days }}
DATABASE_BUSY_TIMEOUT=5s
DATABASE_QUERY_TIMEOUT=2s
DATABASE_MAX_OPEN_CONNS=1
DATABASE_MAX_IDLE_CONNS=1
