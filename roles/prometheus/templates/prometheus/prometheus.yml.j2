global:
  scrape_interval: {{ prometheus_scrape_interval | to_json }}
  evaluation_interval: {{ prometheus_evaluation_interval | to_json }}

scrape_configs:
  - job_name: "prometheus"
    static_configs:
      - targets: ["prometheus:{{ prometheus_service_port }}"]

  - job_name: "prometheus-smartctl-{{ prometheus_local_instance_name }}"
    static_configs:
      - targets: ["prometheus-smartctl:9902"]
        labels:
          instance: {{ prometheus_local_instance_name | to_json }}

  - job_name: "prometheus-node-{{ prometheus_local_instance_name }}"
    static_configs:
      - targets: ["prometheus-node:9100"]
        labels:
          instance: {{ prometheus_local_instance_name | to_json }}

  - job_name: "prometheus-cadvisor-{{ prometheus_local_instance_name }}"
    static_configs:
      - targets: ["prometheus-cadvisor:8080"]
        labels:
          instance: {{ prometheus_local_instance_name | to_json }}

  - job_name: "blackbox"
    metrics_path: /probe
    params:
      module: [icmp]
    static_configs:
      - targets:
{% for target in prometheus_blackbox_targets %}
          - {{ target | to_json }}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: prometheus-blackbox:9115

{% for job in prometheus_additional_scrape_jobs %}
  - job_name: {{ job.job_name | to_json }}
    static_configs:
      - targets:
{% for target in job.targets %}
          - {{ target | to_json }}
{% endfor %}
{% if job.labels | default({}) | length > 0 %}
        labels:
{% for label, value in job.labels.items() %}
          {{ label }}: {{ value | to_json }}
{% endfor %}
{% endif %}
{% endfor %}
