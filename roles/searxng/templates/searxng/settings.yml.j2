use_default_settings: true

general:
  debug: false
  instance_name: "SearXNG"

search:
  safe_search: 2
  autocomplete: "duckduckgo"
  formats:
    - html

server:
  # The actual key comes from the root-only environment file.
  secret_key: "managed-by-searxng-secret"
  limiter: true
  image_proxy: true
  public_instance: false

valkey:
  url: "valkey://{{ searxng_valkey_host }}:{{ searxng_valkey_port }}/0"
